# ============================================================
# Job Hunter — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Telegram ---
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (or group chat ID)
# Use @userinfobot or similar to find your chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Scheduling ---
# How often to run scans (in hours). Default: 6
SCAN_INTERVAL_HOURS=6

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR. Default: INFO
LOG_LEVEL=INFO

# --- Database ---
# Path inside the container where the SQLite DB is stored.
# Usually no need to change this.
DB_PATH=/app/data/jobs.db

# --- Config ---
# Paths to the YAML config files inside the container.
COMPANIES_CONFIG=/app/config/companies.yml
FILTERS_CONFIG=/app/config/filters.yml
